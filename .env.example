# Selección de adaptador por puerto — ver ADR-0002 y docs/architecture.md.
# Cambiar de proveedor es cambiar este valor + escribir el adaptador nuevo,
# nunca reescribir la lógica de negocio.
PAYMENT_PROVIDER=mercadopago
CMS_PROVIDER=sanity
AUTH_PROVIDER=supabase
AI_PROVIDER=claude
EMAIL_PROVIDER=resend
STORAGE_PROVIDER=r2
REALTIME_PROVIDER=supabase

# Modo de acceso — ver ADR-0003. "paid" es la decisión de trabajo (issue
# #3): se asume el mismo esquema pago de la edición 2024 hasta que la
# Cámara confirme el de 2026.
ADMISSION_MODE=paid

# Secreto para firmar el código de admisión (issue #57) — cualquier string
# largo y aleatorio. Sin esto, cae a un secreto de desarrollo inseguro
# marcado como tal en el código; en producción hace falta un valor real.
TICKET_SIGNING_SECRET=

# Access token de Mercado Pago (issue #3/#7) — todavía no existe una
# cuenta de Mercado Pago para el proyecto. El adaptador ya está escrito y
# testeado con fetch mockeado (ver src/lib/adapters/mercadopago-payment-provider.ts);
# sin este valor, PAYMENT_PROVIDER=mercadopago no puede pegarle a la API real.
MERCADOPAGO_ACCESS_TOKEN=

# Supabase (adaptador de AUTH_PROVIDER implementado — ver
# src/lib/adapters/supabase-auth-provider.ts). En Vercel las inyecta la
# integración de Supabase automáticamente; en local, copiá los valores
# reales del dashboard de tu proyecto a .env.local (nunca acá).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credenciales del resto de los proveedores se suman acá a medida que
# se implementa cada adaptador (todavía no existen). Nunca commitear
# este archivo con valores reales — copiarlo a .env.local, que está en
# .gitignore.
