# Selección de adaptador por puerto — ver ADR-0002 y docs/architecture.md.
# Cambiar de proveedor es cambiar este valor + escribir el adaptador nuevo,
# nunca reescribir la lógica de negocio.
PAYMENT_PROVIDER=mercadopago
CMS_PROVIDER=sanity
AUTH_PROVIDER=supabase
AI_PROVIDER=claude
EMAIL_PROVIDER=resend
STORAGE_PROVIDER=r2
REALTIME_PROVIDER=supabase

# Modo de acceso — ver ADR-0003. Gratuito adoptado como default de trabajo.
ADMISSION_MODE=free

# Supabase (adaptador de AUTH_PROVIDER implementado — ver
# src/lib/adapters/supabase-auth-provider.ts). En Vercel las inyecta la
# integración de Supabase automáticamente; en local, copiá los valores
# reales del dashboard de tu proyecto a .env.local (nunca acá).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credenciales del resto de los proveedores se suman acá a medida que
# se implementa cada adaptador (todavía no existen). Nunca commitear
# este archivo con valores reales — copiarlo a .env.local, que está en
# .gitignore.
