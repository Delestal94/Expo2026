# Selección de adaptador por puerto — ver ADR-0002 y docs/architecture.md.
# Cambiar de proveedor es cambiar este valor + escribir el adaptador nuevo,
# nunca reescribir la lógica de negocio.
PAYMENT_PROVIDER=mercadopago
CMS_PROVIDER=sanity
AUTH_PROVIDER=supabase
AI_PROVIDER=claude
EMAIL_PROVIDER=resend
STORAGE_PROVIDER=r2
REALTIME_PROVIDER=supabase

# Modo de acceso — ver ADR-0003, pendiente de confirmar con la Cámara.
ADMISSION_MODE=free

# Credenciales reales de cada proveedor se suman acá a medida que se
# implementa su adaptador (todavía no existen). Nunca commitear este
# archivo con valores reales — copiarlo a .env.local, que está en
# .gitignore.
